[{"s":36,"a":13,"w":["وَٱضْرِبْ","لَهُم","مَّثَلًا","أَصْحَـٰبَ","ٱلْقَرْيَةِ","إِذْ","جَآءَهَا","ٱلْمُرْسَلُونَ"]},{"s":36,"a":14,"w":["إِذْ","أَرْسَلْنَآ","إِلَيْهِمُ","ٱثْنَيْنِ","فَكَذَّبُوهُمَا","فَعَزَّزْنَا","بِثَالِثٍۢ","فَقَالُوٓا۟","إِنَّآ","إِلَيْكُم","مُّرْسَلُونَ"]},{"s":36,"a":15,"w":["قَالُوا۟","مَآ","أَنتُمْ","إِلَّا","بَشَرٌۭ","مِّثْلُنَا","وَمَآ","أَنزَلَ","ٱلرَّحْمَـٰنُ","مِن","شَىْءٍ","إِنْ","أَنتُمْ","إِلَّا","تَكْذِبُونَ"]},{"s":36,"a":16,"w":["قَالُوا۟","رَبُّنَا","يَعْلَمُ","إِنَّآ","إِلَيْكُمْ","لَمُرْسَلُونَ"]},{"s":36,"a":17,"w":["وَمَا","عَلَيْنَآ","إِلَّا","ٱلْبَلَـٰغُ","ٱلْمُبِينُ"]},{"s":36,"a":18,"w":["قَالُوٓا۟","إِنَّا","تَطَيَّرْنَا","بِكُمْ ۖ","لَئِن","لَّمْ","تَنتَهُوا۟","لَنَرْجُمَنَّكُمْ","وَلَيَمَسَّنَّكُم","مِّنَّا","عَذَابٌ","أَلِيمٌۭ"]},{"s":36,"a":19,"w":["قَالُوا۟","طَـٰٓئِرُكُم","مَّعَكُمْ ۚ","أَئِن","ذُكِّرْتُم ۚ","بَلْ","أَنتُمْ","قَوْمٌۭ","مُّسْرِفُونَ"]},{"s":36,"a":20,"w":["وَجَآءَ","مِنْ","أَقْصَا","ٱلْمَدِينَةِ","رَجُلٌۭ","يَسْعَىٰ","قَالَ","يَـٰقَوْمِ","ٱتَّبِعُوا۟","ٱلْمُرْسَلِينَ"]},{"s":36,"a":21,"w":["ٱتَّبِعُوا۟","مَن","لَّا","يَسْـَٔلُكُمْ","أَجْرًۭا","وَهُم","مُّهْتَدُونَ"]},{"s":36,"a":22,"w":["وَمَا","لِىَ","لَآ","أَعْبُدُ","ٱلَّذِى","فَطَرَنِى","وَإِلَيْهِ","تُرْجَعُونَ"]},{"s":36,"a":23,"w":["ءَأَتَّخِذُ","مِن","دُونِهِۦٓ","ءَالِهَةً","إِن","يُرِدْنِ","ٱلرَّحْمَـٰنُ","بِضُرٍّۢ","لَّا","تُغْنِ","عَنِّى","شَفَـٰعَتُهُمْ","شَيْـًۭٔا","وَلَا","يُنقِذُونِ"]},{"s":36,"a":24,"w":["إِنِّىٓ","إِذًۭا","لَّفِى","ضَلَـٰلٍۢ","مُّبِينٍ"]},{"s":36,"a":25,"w":["إِنِّىٓ","ءَامَنتُ","بِرَبِّكُمْ","فَٱسْمَعُونِ"]},{"s":36,"a":26,"w":["قِيلَ","ٱدْخُلِ","ٱلْجَنَّةَ ۖ","قَالَ","يَـٰلَيْتَ","قَوْمِى","يَعْلَمُونَ"]},{"s":36,"a":27,"w":["بِمَا","غَفَرَ","لِى","رَبِّى","وَجَعَلَنِى","مِنَ","ٱلْمُكْرَمِينَ"]}]