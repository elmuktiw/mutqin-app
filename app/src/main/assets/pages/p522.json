[{"s":51,"a":31,"w":["۞ قَالَ","فَمَا","خَطْبُكُمْ","أَيُّهَا","ٱلْمُرْسَلُونَ"]},{"s":51,"a":32,"w":["قَالُوٓا۟","إِنَّآ","أُرْسِلْنَآ","إِلَىٰ","قَوْمٍۢ","مُّجْرِمِينَ"]},{"s":51,"a":33,"w":["لِنُرْسِلَ","عَلَيْهِمْ","حِجَارَةًۭ","مِّن","طِينٍۢ"]},{"s":51,"a":34,"w":["مُّسَوَّمَةً","عِندَ","رَبِّكَ","لِلْمُسْرِفِينَ"]},{"s":51,"a":35,"w":["فَأَخْرَجْنَا","مَن","كَانَ","فِيهَا","مِنَ","ٱلْمُؤْمِنِينَ"]},{"s":51,"a":36,"w":["فَمَا","وَجَدْنَا","فِيهَا","غَيْرَ","بَيْتٍۢ","مِّنَ","ٱلْمُسْلِمِينَ"]},{"s":51,"a":37,"w":["وَتَرَكْنَا","فِيهَآ","ءَايَةًۭ","لِّلَّذِينَ","يَخَافُونَ","ٱلْعَذَابَ","ٱلْأَلِيمَ"]},{"s":51,"a":38,"w":["وَفِى","مُوسَىٰٓ","إِذْ","أَرْسَلْنَـٰهُ","إِلَىٰ","فِرْعَوْنَ","بِسُلْطَـٰنٍۢ","مُّبِينٍۢ"]},{"s":51,"a":39,"w":["فَتَوَلَّىٰ","بِرُكْنِهِۦ","وَقَالَ","سَـٰحِرٌ","أَوْ","مَجْنُونٌۭ"]},{"s":51,"a":40,"w":["فَأَخَذْنَـٰهُ","وَجُنُودَهُۥ","فَنَبَذْنَـٰهُمْ","فِى","ٱلْيَمِّ","وَهُوَ","مُلِيمٌۭ"]},{"s":51,"a":41,"w":["وَفِى","عَادٍ","إِذْ","أَرْسَلْنَا","عَلَيْهِمُ","ٱلرِّيحَ","ٱلْعَقِيمَ"]},{"s":51,"a":42,"w":["مَا","تَذَرُ","مِن","شَىْءٍ","أَتَتْ","عَلَيْهِ","إِلَّا","جَعَلَتْهُ","كَٱلرَّمِيمِ"]},{"s":51,"a":43,"w":["وَفِى","ثَمُودَ","إِذْ","قِيلَ","لَهُمْ","تَمَتَّعُوا۟","حَتَّىٰ","حِينٍۢ"]},{"s":51,"a":44,"w":["فَعَتَوْا۟","عَنْ","أَمْرِ","رَبِّهِمْ","فَأَخَذَتْهُمُ","ٱلصَّـٰعِقَةُ","وَهُمْ","يَنظُرُونَ"]},{"s":51,"a":45,"w":["فَمَا","ٱسْتَطَـٰعُوا۟","مِن","قِيَامٍۢ","وَمَا","كَانُوا۟","مُنتَصِرِينَ"]},{"s":51,"a":46,"w":["وَقَوْمَ","نُوحٍۢ","مِّن","قَبْلُ ۖ","إِنَّهُمْ","كَانُوا۟","قَوْمًۭا","فَـٰسِقِينَ"]},{"s":51,"a":47,"w":["وَٱلسَّمَآءَ","بَنَيْنَـٰهَا","بِأَيْي۟دٍۢ","وَإِنَّا","لَمُوسِعُونَ"]},{"s":51,"a":48,"w":["وَٱلْأَرْضَ","فَرَشْنَـٰهَا","فَنِعْمَ","ٱلْمَـٰهِدُونَ"]},{"s":51,"a":49,"w":["وَمِن","كُلِّ","شَىْءٍ","خَلَقْنَا","زَوْجَيْنِ","لَعَلَّكُمْ","تَذَكَّرُونَ"]},{"s":51,"a":50,"w":["فَفِرُّوٓا۟","إِلَى","ٱللَّهِ ۖ","إِنِّى","لَكُم","مِّنْهُ","نَذِيرٌۭ","مُّبِينٌۭ"]},{"s":51,"a":51,"w":["وَلَا","تَجْعَلُوا۟","مَعَ","ٱللَّهِ","إ