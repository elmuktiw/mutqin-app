[{"s":36,"a":28,"w":["۞ وَمَآ","أَنزَلْنَا","عَلَىٰ","قَوْمِهِۦ","مِنۢ","بَعْدِهِۦ","مِن","جُندٍۢ","مِّنَ","ٱلسَّمَآءِ","وَمَا","كُنَّا","مُنزِلِينَ"]},{"s":36,"a":29,"w":["إِن","كَانَتْ","إِلَّا","صَيْحَةًۭ","وَٰحِدَةًۭ","فَإِذَا","هُمْ","خَـٰمِدُونَ"]},{"s":36,"a":30,"w":["يَـٰحَسْرَةً","عَلَى","ٱلْعِبَادِ ۚ","مَا","يَأْتِيهِم","مِّن","رَّسُولٍ","إِلَّا","كَانُوا۟","بِهِۦ","يَسْتَهْزِءُونَ"]},{"s":36,"a":31,"w":["أَلَمْ","يَرَوْا۟","كَمْ","أَهْلَكْنَا","قَبْلَهُم","مِّنَ","ٱلْقُرُونِ","أَنَّهُمْ","إِلَيْهِمْ","لَا","يَرْجِعُونَ"]},{"s":36,"a":32,"w":["وَإِن","كُلٌّۭ","لَّمَّا","جَمِيعٌۭ","لَّدَيْنَا","مُحْضَرُونَ"]},{"s":36,"a":33,"w":["وَءَايَةٌۭ","لَّهُمُ","ٱلْأَرْضُ","ٱلْمَيْتَةُ","أَحْيَيْنَـٰهَا","وَأَخْرَجْنَا","مِنْهَا","حَبًّۭا","فَمِنْهُ","يَأْكُلُونَ"]},{"s":36,"a":34,"w":["وَجَعَلْنَا","فِيهَا","جَنَّـٰتٍۢ","مِّن","نَّخِيلٍۢ","وَأَعْنَـٰبٍۢ","وَفَجَّرْنَا","فِيهَا","مِنَ","ٱلْعُيُونِ"]},{"s":36,"a":35,"w":["لِيَأْكُلُوا۟","مِن","ثَمَرِهِۦ","وَمَا","عَمِلَتْهُ","أَيْدِيهِمْ ۖ","أَفَلَا","يَشْكُرُونَ"]},{"s":36,"a":36,"w":["سُبْحَـٰنَ","ٱلَّذِى","خَلَقَ","ٱلْأَزْوَٰجَ","كُلَّهَا","مِمَّا","تُنۢبِتُ","ٱلْأَرْضُ","وَمِنْ","أَنفُسِهِمْ","وَمِمَّا","لَا","يَعْلَمُونَ"]},{"s":36,"a":37,"w":["وَءَايَةٌۭ","لَّهُمُ","ٱلَّيْلُ","نَسْلَخُ","مِنْهُ","ٱلنَّهَارَ","فَإِذَا","هُم","مُّظْلِمُونَ"]},{"s":36,"a":38,"w":["وَٱلشَّمْسُ","تَجْرِى","لِمُسْتَقَرٍّۢ","لَّهَا ۚ","ذَٰلِكَ","تَقْدِيرُ","ٱلْعَزِيزِ","ٱلْعَلِيمِ"]},{"s":36,"a":39,"w":["وَٱلْقَمَرَ","قَدَّرْنَـٰهُ","مَنَازِلَ","حَتَّىٰ","عَادَ","كَٱلْعُرْجُونِ","ٱلْقَدِيمِ"]},{"s":36,"a":40,"w":["لَا","ٱلشَّمْسُ","يَنۢبَغِى","لَهَآ","أَن","تُدْرِكَ","ٱلْقَمَرَ","وَلَا","ٱلَّيْلُ","سَابِقُ","ٱلنَّهَارِ ۚ","وَكُلٌّۭ","فِى","فَلَكٍۢ","يَسْبَحُونَ"]}]