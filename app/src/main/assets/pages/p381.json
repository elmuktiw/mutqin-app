[{"s":27,"a":45,"w":["وَلَقَدْ","أَرْسَلْنَآ","إِلَىٰ","ثَمُودَ","أَخَاهُمْ","صَـٰلِحًا","أَنِ","ٱعْبُدُوا۟","ٱللَّهَ","فَإِذَا","هُمْ","فَرِيقَانِ","يَخْتَصِمُونَ"]},{"s":27,"a":46,"w":["قَالَ","يَـٰقَوْمِ","لِمَ","تَسْتَعْجِلُونَ","بِٱلسَّيِّئَةِ","قَبْلَ","ٱلْحَسَنَةِ ۖ","لَوْلَا","تَسْتَغْفِرُونَ","ٱللَّهَ","لَعَلَّكُمْ","تُرْحَمُونَ"]},{"s":27,"a":47,"w":["قَالُوا۟","ٱطَّيَّرْنَا","بِكَ","وَبِمَن","مَّعَكَ ۚ","قَالَ","طَـٰٓئِرُكُمْ","عِندَ","ٱللَّهِ ۖ","بَلْ","أَنتُمْ","قَوْمٌۭ","تُفْتَنُونَ"]},{"s":27,"a":48,"w":["وَكَانَ","فِى","ٱلْمَدِينَةِ","تِسْعَةُ","رَهْطٍۢ","يُفْسِدُونَ","فِى","ٱلْأَرْضِ","وَلَا","يُصْلِحُونَ"]},{"s":27,"a":49,"w":["قَالُوا۟","تَقَاسَمُوا۟","بِٱللَّهِ","لَنُبَيِّتَنَّهُۥ","وَأَهْلَهُۥ","ثُمَّ","لَنَقُولَنَّ","لِوَلِيِّهِۦ","مَا","شَهِدْنَا","مَهْلِكَ","أَهْلِهِۦ","وَإِنَّا","لَصَـٰدِقُونَ"]},{"s":27,"a":50,"w":["وَمَكَرُوا۟","مَكْرًۭا","وَمَكَرْنَا","مَكْرًۭا","وَهُمْ","لَا","يَشْعُرُونَ"]},{"s":27,"a":51,"w":["فَٱنظُرْ","كَيْفَ","كَانَ","عَـٰقِبَةُ","مَكْرِهِمْ","أَنَّا","دَمَّرْنَـٰهُمْ","وَقَوْمَهُمْ","أَجْمَعِينَ"]},{"s":27,"a":52,"w":["فَتِلْكَ","بُيُوتُهُمْ","خَاوِيَةًۢ","بِمَا","ظَلَمُوٓا۟ ۗ","إِنَّ","فِى","ذَٰلِكَ","لَـَٔايَةًۭ","لِّقَوْمٍۢ","يَعْلَمُونَ"]},{"s":27,"a":53,"w":["وَأَنجَيْنَا","ٱلَّذِينَ","ءَامَنُوا۟","وَكَانُوا۟","يَتَّقُونَ"]},{"s":27,"a":54,"w":["وَلُوطًا","إِذْ","قَالَ","لِقَوْمِهِۦٓ","أَتَأْتُونَ","ٱلْفَـٰحِشَةَ","وَأَنتُمْ","تُبْصِرُونَ"]},{"s":27,"a":55,"w":["أَئِنَّكُمْ","لَتَأْتُونَ","ٱلرِّجَالَ","شَهْوَةًۭ","مِّن","دُونِ","ٱلنِّسَآءِ ۚ","بَلْ","أَنتُمْ","قَوْمٌۭ","تَجْهَلُونَ"]}]