[{"s":52,"a":15,"w":["أَفَسِحْرٌ","هَـٰذَآ","أَمْ","أَنتُمْ","لَا","تُبْصِرُونَ"]},{"s":52,"a":16,"w":["ٱصْلَوْهَا","فَٱصْبِرُوٓا۟","أَوْ","لَا","تَصْبِرُوا۟","سَوَآءٌ","عَلَيْكُمْ ۖ","إِنَّمَا","تُجْزَوْنَ","مَا","كُنتُمْ","تَعْمَلُونَ"]},{"s":52,"a":17,"w":["إِنَّ","ٱلْمُتَّقِينَ","فِى","جَنَّـٰتٍۢ","وَنَعِيمٍۢ"]},{"s":52,"a":18,"w":["فَـٰكِهِينَ","بِمَآ","ءَاتَىٰهُمْ","رَبُّهُمْ","وَوَقَىٰهُمْ","رَبُّهُمْ","عَذَابَ","ٱلْجَحِيمِ"]},{"s":52,"a":19,"w":["كُلُوا۟","وَٱشْرَبُوا۟","هَنِيٓـًٔۢا","بِمَا","كُنتُمْ","تَعْمَلُونَ"]},{"s":52,"a":20,"w":["مُتَّكِـِٔينَ","عَلَىٰ","سُرُرٍۢ","مَّصْفُوفَةٍۢ ۖ","وَزَوَّجْنَـٰهُم","بِحُورٍ","عِينٍۢ"]},{"s":52,"a":21,"w":["وَٱلَّذِينَ","ءَامَنُوا۟","وَٱتَّبَعَتْهُمْ","ذُرِّيَّتُهُم","بِإِيمَـٰنٍ","أَلْحَقْنَا","بِهِمْ","ذُرِّيَّتَهُمْ","وَمَآ","أَلَتْنَـٰهُم","مِّنْ","عَمَلِهِم","مِّن","شَىْءٍۢ ۚ","كُلُّ","ٱمْرِئٍۭ","بِمَا","كَسَبَ","رَهِينٌۭ"]},{"s":52,"a":22,"w":["وَأَمْدَدْنَـٰهُم","بِفَـٰكِهَةٍۢ","وَلَحْمٍۢ","مِّمَّا","يَشْتَهُونَ"]},{"s":52,"a":23,"w":["يَتَنَـٰزَعُونَ","فِيهَا","كَأْسًۭا","لَّا","لَغْوٌۭ","فِيهَا","وَلَا","تَأْثِيمٌۭ"]},{"s":52,"a":24,"w":["۞ وَيَطُوفُ","عَلَيْهِمْ","غِلْمَانٌۭ","لَّهُمْ","كَأَنَّهُمْ","لُؤْلُؤٌۭ","مَّكْنُونٌۭ"]},{"s":52,"a":25,"w":["وَأَقْبَلَ","بَعْضُهُمْ","عَلَىٰ","بَعْضٍۢ","يَتَسَآءَلُونَ"]},{"s":52,"a":26,"w":["قَالُوٓا۟","إِنَّا","كُنَّا","قَبْلُ","فِىٓ","أَهْلِنَا","مُشْفِقِينَ"]},{"s":52,"a":27,"w":["فَمَنَّ","ٱللَّهُ","عَلَيْنَا","وَوَقَىٰنَا","عَذَابَ","ٱلسَّمُومِ"]},{"s":52,"a":28,"w":["إِنَّا","كُنَّا","مِن","قَبْلُ","نَدْعُوهُ ۖ","إِنَّهُۥ","هُوَ","ٱلْبَرُّ","ٱلرَّحِيمُ"]},{"s":52,"a":29,"w":["فَذَكِّرْ","فَمَآ","أَنتَ","بِنِعْمَتِ","رَبِّكَ","بِكَاهِنٍۢ","وَلَا","مَجْنُونٍ"]},{"s":52,"a":30,"w":["أَمْ","يَقُولُونَ","شَاعِرٌۭ","نَّتَرَبَّصُ","بِهِۦ","رَيْبَ","ٱلْمَنُونِ"]},{"s":52,"a":31,"w":["قُلْ","تَرَبَّصُوا۟","فَإِنِّى","مَعَكُم","مِّنَ","ٱلْمُتَرَبِّصِينَ"]}]