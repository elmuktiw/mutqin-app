["بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ...","الٓمٓ ۝ ذَٰلِكَ ٱلْكِتَـٰبُ لَا رَيْبَ ...","إِنَّ ٱلَّذِينَ كَفَرُوا۟ سَوَآءٌ عَلَيْهِمْ ...","مَثَلُهُمْ كَمَثَلِ ٱلَّذِى ٱسْتَوْقَدَ نَارًا ...","وَبَشِّرِ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ ...","وَإِذْ قَالَ رَبُّكَ لِلْمَلَـٰٓئِكَةِ إِنِّى ...","قُلْنَا ٱهْبِطُوا۟ مِنْهَا جَمِيعًا ۖ ...","وَإِذْ نَجَّيْنَـٰكُم مِّنْ ءَالِ فِرْعَوْنَ ...","وَإِذْ قُلْنَا ٱدْخُلُوا۟ هَـٰذِهِ ٱلْقَرْيَةَ ...","إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَٱلَّذِينَ هَادُوا۟ ...","قَالُوا۟ ٱدْعُ لَنَا رَبَّكَ يُبَيِّن ...","أَوَلَا يَعْلَمُونَ أَنَّ ٱللَّهَ يَعْلَمُ ...","وَإِذْ أَخَذْنَا مِيثَـٰقَكُمْ لَا تَسْفِكُونَ ...","وَلَمَّا جَآءَهُمْ كِتَـٰبٌ مِّنْ عِندِ ...","قُلْ إِن كَانَتْ لَكُمُ ٱلدَّارُ ...","وَٱتَّبَعُوا۟ مَا تَتْلُوا۟ ٱلشَّيَـٰطِينُ عَلَىٰ ...","۞ مَا نَنسَخْ مِنْ ءَايَةٍ ...","وَقَالَتِ ٱلْيَهُودُ لَيْسَتِ ٱلنَّصَـٰرَىٰ عَلَىٰ ...","وَلَن تَرْضَىٰ عَنكَ ٱلْيَهُودُ وَلَا ...","وَإِذْ يَرْفَعُ إِبْرَٰهِـۧمُ ٱلْقَوَاعِدَ مِنَ ...","وَقَالُوا۟ كُونُوا۟ هُودًا أَوْ نَصَـٰرَىٰ ...","۞ سَيَقُولُ ٱلسُّفَهَآءُ مِنَ ٱلنَّاسِ ...","ٱلَّذِينَ ءَاتَيْنَـٰهُمُ ٱلْكِتَـٰبَ يَعْرِفُونَهُۥ كَمَا ...","وَلَا تَقُولُوا۟ لِمَن يُقْتَلُ فِى ...","إِنَّ فِى خَلْقِ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ ...","وَإِذَا قِيلَ لَهُمُ ٱتَّبِعُوا۟ مَآ ...","۞ لَّيْسَ ٱلْبِرَّ أَن تُوَلُّوا۟ ...","فَمَنْ خَافَ مِن مُّوصٍ جَنَفًا ...","أُحِلَّ لَكُمْ لَيْلَةَ ٱلصِّيَامِ ٱلرَّفَثُ ...","وَٱقْتُلُوهُمْ حَيْثُ ثَقِفْتُمُوهُمْ وَأَخْرِجُوهُم مِّنْ ...","ٱلْحَجُّ أَشْهُرٌ مَّعْلُومَـٰتٌ ۚ فَمَن ...","۞ وَٱذْكُرُوا۟ ٱللَّهَ فِىٓ أَيَّامٍ ...","سَلْ بَنِىٓ إِسْرَٰٓءِيلَ كَمْ ءَاتَيْنَـٰهُم ...","كُتِبَ عَلَيْكُمُ ٱلْقِتَالُ وَهُوَ كُرْهٌ ...","فِى ٱلدُّنْيَا وَٱلْـَٔاخِرَةِ ۗ وَيَسْـَٔلُونَكَ ...","لَّا يُؤَاخِذُكُمُ ٱللَّهُ بِٱللَّغْوِ فِىٓ ...","وَإِذَا طَلَّقْتُمُ ٱلنِّسَآءَ فَبَلَغْنَ أَجَلَهُنَّ ...","وَٱلَّذِينَ يُتَوَفَّوْنَ مِنكُمْ وَيَذَرُونَ أَزْوَٰجًا ...","حَـٰفِظُوا۟ عَلَى ٱلصَّلَوَٰتِ وَٱلصَّلَوٰةِ ٱلْوُسْطَىٰ ...","أَلَمْ تَرَ إِلَى ٱلْمَلَإِ مِنۢ ...","فَلَمَّا فَصَلَ طَالُوتُ بِٱلْجُنُودِ قَالَ ...","۞ تِلْكَ ٱلرُّسُلُ فَضَّلْنَا بَعْضَهُمْ ...","ٱللَّهُ وَلِىُّ ٱلَّذِينَ ءَامَنُوا۟ يُخْرِجُهُم ...","وَإِذْ قَالَ إِبْرَٰهِـۧمُ رَبِّ أَرِنِى ...","وَمَثَلُ ٱلَّذِينَ يُنفِقُونَ أَمْوَٰلَهُمُ ٱبْتِغَآءَ ...","وَمَآ أَنفَقْتُم مِّن نَّفَقَةٍ أَوْ ...","ٱلَّذِينَ يَأْكُلُونَ ٱلرِّبَوٰا۟ لَا يَقُومُونَ ...","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا تَدَايَنتُم ...","۞ وَإِن كُنتُمْ عَلَىٰ سَفَرٍ ...","الٓمٓ ۝ ٱللَّهُ لَآ إِلَـٰهَ إِلَّا ...","إِنَّ ٱلَّذِينَ كَفَرُوا۟ لَن تُغْنِىَ ...","ٱلَّذِينَ يَقُولُونَ رَبَّنَآ إِنَّنَآ ءَامَنَّا ...","أَلَمْ تَرَ إِلَى ٱلَّذِينَ أُوتُوا۟ ...","يَوْمَ تَجِدُ كُلُّ نَفْسٍ مَّا ...","هُنَالِكَ دَعَا زَكَرِيَّا رَبَّهُۥ ۖ ...","وَيُكَلِّمُ ٱلنَّاسَ فِى ٱلْمَهْدِ وَكَهْلًا ...","رَبَّنَآ ءَامَنَّا بِمَآ أَنزَلْتَ وَٱتَّبَعْنَا ...","إِنَّ هَـٰذَا لَهُوَ ٱلْقَصَصُ ٱلْحَقُّ ...","يَـٰٓأَهْلَ ٱلْكِتَـٰبِ لِمَ تَلْبِسُونَ ٱلْحَقَّ ...","وَإِنَّ مِنْهُمْ لَفَرِيقًا يَلْوُۥنَ أَلْسِنَتَهُم ...","قُلْ ءَامَنَّا بِٱللَّهِ وَمَآ أُنزِلَ ...","لَن تَنَالُوا۟ ٱلْبِرَّ حَتَّىٰ تُنفِقُوا۟ ...","وَكَيْفَ تَكْفُرُونَ وَأَنتُمْ تُتْلَىٰ عَلَيْكُمْ ...","وَلِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا ...","إِنَّ ٱلَّذِينَ كَفَرُوا۟ لَن تُغْنِىَ ...","إِذْ هَمَّت طَّآئِفَتَانِ مِنكُمْ أَن ...","۞ وَسَارِعُوٓا۟ إِلَىٰ مَغْفِرَةٍ مِّن ...","وَلِيُمَحِّصَ ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟ وَيَمْحَقَ ...","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِن تُطِيعُوا۟ ...","ثُمَّ أَنزَلَ عَلَيْكُم مِّنۢ بَعْدِ ...","وَلَئِن مُّتُّمْ أَوْ قُتِلْتُمْ لَإِلَى ...","وَمَآ أَصَـٰبَكُمْ يَوْمَ ٱلْتَقَى ٱلْجَمْعَانِ ...","فَٱنقَلَبُوا۟ بِنِعْمَةٍ مِّنَ ٱللَّهِ وَفَضْلٍ ...","لَّقَدْ سَمِعَ ٱللَّهُ قَوْلَ ٱلَّذِينَ ...","وَإِذْ أَخَذَ ٱللَّهُ مِيثَـٰقَ ٱلَّذِينَ ...","فَٱسْتَجَابَ لَهُمْ رَبُّهُمْ أَنِّى لَآ ...","يَـٰٓأَيُّهَا ٱلنَّاسُ ٱتَّقُوا۟ رَبَّكُمُ ٱلَّذِى ...","لِّلرِّجَالِ نَصِيبٌ مِّمَّا تَرَكَ ٱلْوَٰلِدَانِ ...","۞ وَلَكُمْ نِصْفُ مَا تَرَكَ ...","وَٱلَّـٰتِى يَأْتِينَ ٱلْفَـٰحِشَةَ مِن نِّسَآئِكُمْ ...","وَإِنْ أَرَدتُّمُ ٱسْتِبْدَالَ زَوْجٍ مَّكَانَ ...","۞ وَٱلْمُحْصَنَـٰتُ مِنَ ٱلنِّسَآءِ إِلَّا ...","وَٱللَّهُ يُرِيدُ أَن يَتُوبَ عَلَيْكُمْ ...","ٱلرِّجَالُ قَوَّٰمُونَ عَلَى ٱلنِّسَآءِ بِمَا ...","وَٱلَّذِينَ يُنفِقُونَ أَمْوَٰلَهُمْ رِئَآءَ ٱلنَّاسِ ...","وَٱللَّهُ أَعْلَمُ بِأَعْدَآئِكُمْ ۚ وَكَفَىٰ ...","أُو۟لَـٰٓئِكَ ٱلَّذِينَ لَعَنَهُمُ ٱللَّهُ ۖ ...","أَلَمْ تَرَ إِلَى ٱلَّذِينَ يَزْعُمُونَ ...","وَلَوْ أَنَّا كَتَبْنَا عَلَيْهِمْ أَنِ ...","وَمَا لَكُمْ لَا تُقَـٰتِلُونَ فِى ...","مَّن يُطِعِ ٱلرَّسُولَ فَقَدْ أَطَاعَ ...","ٱللَّهُ لَآ إِلَـٰهَ إِلَّا هُوَ ...","وَمَا كَانَ لِمُؤْمِنٍ أَن يَقْتُلَ ...","لَّا يَسْتَوِى ٱلْقَـٰعِدُونَ مِنَ ٱلْمُؤْمِنِينَ ...","وَإِذَا كُنتَ فِيهِمْ فَأَقَمْتَ لَهُمُ ...","وَٱسْتَغْفِرِ ٱللَّهَ ۖ إِنَّ ٱللَّهَ ...","۞ لَّا خَيْرَ فِى كَثِيرٍ ...","وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ سَنُدْخِلُهُمْ ...","وَإِنِ ٱمْرَأَةٌ خَافَتْ مِنۢ بَعْلِهَا ...","۞ يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ كُونُوا۟ ...","ٱلَّذِينَ يَتَرَبَّصُونَ بِكُمْ فَإِن كَانَ ...","۞ لَّا يُحِبُّ ٱللَّهُ ٱلْجَهْرَ ...","فَبِمَا نَقْضِهِم مِّيثَـٰقَهُمْ وَكُفْرِهِم بِـَٔايَـٰتِ ...","۞ إِنَّآ أَوْحَيْنَآ إِلَيْكَ كَمَآ ...","يَـٰٓأَهْلَ ٱلْكِتَـٰبِ لَا تَغْلُوا۟ فِى ...","يَسْتَفْتُونَكَ قُلِ ٱللَّهُ يُفْتِيكُمْ فِى ...","حُرِّمَتْ عَلَيْكُمُ ٱلْمَيْتَةُ وَٱلدَّمُ وَلَحْمُ ...","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا قُمْتُمْ ...","وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَـٰتِنَآ أُو۟لَـٰٓئِكَ ...","وَمِنَ ٱلَّذِينَ قَالُوٓا۟ إِنَّا نَصَـٰرَىٰٓ ...","وَقَالَتِ ٱلْيَهُودُ وَٱلنَّصَـٰرَىٰ نَحْنُ أَبْنَـٰٓؤُا۟ ...","قَالُوا۟ يَـٰمُوسَىٰٓ إِنَّا لَن نَّدْخُلَهَآ ...","مِنْ أَجْلِ ذَٰلِكَ كَتَبْنَا عَلَىٰ ...","يُرِيدُونَ أَن يَخْرُجُوا۟ مِنَ ٱلنَّارِ ...","سَمَّـٰعُونَ لِلْكَذِبِ أَكَّـٰلُونَ لِلسُّحْتِ ۚ ...","وَقَفَّيْنَا عَلَىٰٓ ءَاثَـٰرِهِم بِعِيسَى ٱبْنِ ...","۞ يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا ...","وَإِذَا نَادَيْتُمْ إِلَى ٱلصَّلَوٰةِ ٱتَّخَذُوهَا ...","وَلَوْ أَنَّ أَهْلَ ٱلْكِتَـٰبِ ءَامَنُوا۟ ...","وَحَسِبُوٓا۟ أَلَّا تَكُونَ فِتْنَةٌ فَعَمُوا۟ ...","قُلْ يَـٰٓأَهْلَ ٱلْكِتَـٰبِ لَا تَغْلُوا۟ ...","وَإِذَا سَمِعُوا۟ مَآ أُنزِلَ إِلَى ...","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّمَا ٱلْخَمْرُ ...","أُحِلَّ لَكُمْ صَيْدُ ٱلْبَحْرِ وَطَعَامُهُۥ ...","وَإِذَا قِيلَ لَهُمْ تَعَالَوْا۟ إِلَىٰ ...","۞ يَوْمَ يَجْمَعُ ٱللَّهُ ٱلرُّسُلَ ...","قَالَ عِيسَى ٱبْنُ مَرْيَمَ ٱللَّهُمَّ ...","ٱلْحَمْدُ لِلَّهِ ٱلَّذِى خَلَقَ ٱلسَّمَـٰوَٰتِ ...","وَلَوْ جَعَلْنَـٰهُ مَلَكًا لَّجَعَلْنَـٰهُ رَجُلًا ...","قُلْ أَىُّ شَىْءٍ أَكْبَرُ شَهَـٰدَةً ...","بَلْ بَدَا لَهُم مَّا كَانُوا۟ ...","۞ إِنَّمَا يَسْتَجِيبُ ٱلَّذِينَ يَسْمَعُونَ ...","فَقُطِعَ دَابِرُ ٱلْقَوْمِ ٱلَّذِينَ ظَلَمُوا۟ ...","وَكَذَٰلِكَ فَتَنَّا بَعْضَهُم بِبَعْضٍ لِّيَقُولُوٓا۟ ...","وَهُوَ ٱلَّذِى يَتَوَفَّىٰكُم بِٱلَّيْلِ وَيَعْلَمُ ...","وَمَا عَلَى ٱلَّذِينَ يَتَّقُونَ مِنْ ...","۞ وَإِذْ قَالَ إِبْرَٰهِيمُ لِأَبِيهِ ...","ٱلَّذِينَ ءَامَنُوا۟ وَلَمْ يَلْبِسُوٓا۟ إِيمَـٰنَهُم ...","وَمَا قَدَرُوا۟ ٱللَّهَ حَقَّ قَدْرِهِۦٓ ...","۞ إِنَّ ٱللَّهَ فَالِقُ ٱلْحَبِّ ...","ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْ ۖ لَآ ...","۞ وَلَوْ أَنَّنَا نَزَّلْنَآ إِلَيْهِمُ ...","وَمَا لَكُمْ أَلَّا تَأْكُلُوا۟ مِمَّا ...","فَمَن يُرِدِ ٱللَّهُ أَن يَهْدِيَهُۥ ...","وَلِكُلٍّ دَرَجَـٰتٌ مِّمَّا عَمِلُوا۟ ۚ ...","وَقَالُوا۟ هَـٰذِهِۦٓ أَنْعَـٰمٌ وَحَرْثٌ حِجْرٌ ...","ثَمَـٰنِيَةَ أَزْوَٰجٍ ۖ مِّنَ ٱلضَّأْنِ ...","فَإِن كَذَّبُوكَ فَقُل رَّبُّكُمْ ذُو ...","وَلَا تَقْرَبُوا۟ مَالَ ٱلْيَتِيمِ إِلَّا ...","هَلْ يَنظُرُونَ إِلَّآ أَن تَأْتِيَهُمُ ...","الٓمٓصٓ ۝ كِتَـٰبٌ أُنزِلَ إِلَيْكَ فَلَا ...","قَالَ مَا مَنَعَكَ أَلَّا تَسْجُدَ ...","قَالَا رَبَّنَا ظَلَمْنَآ أَنفُسَنَا وَإِن ...","۞ يَـٰبَنِىٓ ءَادَمَ خُذُوا۟ زِينَتَكُمْ ...","قَالَ ٱدْخُلُوا۟ فِىٓ أُمَمٍ قَدْ ...","وَنَادَىٰٓ أَصْحَـٰبُ ٱلْجَنَّةِ أَصْحَـٰبَ ٱلنَّارِ ...","وَلَقَدْ جِئْنَـٰهُم بِكِتَـٰبٍ فَصَّلْنَـٰهُ عَلَىٰ ...","وَٱلْبَلَدُ ٱلطَّيِّبُ يَخْرُجُ نَبَاتُهُۥ بِإِذْنِ ...","أُبَلِّغُكُمْ رِسَـٰلَـٰتِ رَبِّى وَأَنَا۠ لَكُمْ ...","وَٱذْكُرُوٓا۟ إِذْ جَعَلَكُمْ خُلَفَآءَ مِنۢ ...","وَمَا كَانَ جَوَابَ قَوْمِهِۦٓ إِلَّآ ...","۞ قَالَ ٱلْمَلَأُ ٱلَّذِينَ ٱسْتَكْبَرُوا۟ ...","وَلَوْ أَنَّ أَهْلَ ٱلْقُرَىٰٓ ءَامَنُوا۟ ...","حَقِيقٌ عَلَىٰٓ أَن لَّآ أَقُولَ ...","قَالُوٓا۟ ءَامَنَّا بِرَبِّ ٱلْعَـٰلَمِينَ ...","فَإِذَا جَآءَتْهُمُ ٱلْحَسَنَةُ قَالُوا۟ لَنَا ...","وَجَـٰوَزْنَا بِبَنِىٓ إِسْرَٰٓءِيلَ ٱلْبَحْرَ فَأَتَوْا۟ ...","قَالَ يَـٰمُوسَىٰٓ إِنِّى ٱصْطَفَيْتُكَ عَلَى ...","وَلَمَّا رَجَعَ مُوسَىٰٓ إِلَىٰ قَوْمِهِۦ ...","۞ وَٱكْتُبْ لَنَا فِى هَـٰذِهِ ...","وَقَطَّعْنَـٰهُمُ ٱثْنَتَىْ عَشْرَةَ أَسْبَاطًا أُمَمًا ...","وَإِذْ قَالَتْ أُمَّةٌ مِّنْهُمْ لِمَ ...","۞ وَإِذْ نَتَقْنَا ٱلْجَبَلَ فَوْقَهُمْ ...","وَلَقَدْ ذَرَأْنَا لِجَهَنَّمَ كَثِيرًا مِّنَ ...","قُل لَّآ أَمْلِكُ لِنَفْسِى نَفْعًا ...","إِنَّ وَلِـِّۧىَ ٱللَّهُ ٱلَّذِى نَزَّلَ ...","يَسْـَٔلُونَكَ عَنِ ٱلْأَنفَالِ ۖ قُلِ ...","إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَٱسْتَجَابَ لَكُمْ ...","فَلَمْ تَقْتُلُوهُمْ وَلَـٰكِنَّ ٱللَّهَ قَتَلَهُمْ ...","وَٱذْكُرُوٓا۟ إِذْ أَنتُمْ قَلِيلٌ مُّسْتَضْعَفُونَ ...","وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ ٱللَّهُ ...","۞ وَٱعْلَمُوٓا۟ أَنَّمَا غَنِمْتُم مِّن ...","وَأَطِيعُوا۟ ٱللَّهَ وَرَسُولَهُۥ وَلَا تَنَـٰزَعُوا۟ ...","ذَٰلِكَ بِأَنَّ ٱللَّهَ لَمْ يَكُ ...","وَإِن يُرِيدُوٓا۟ أَن يَخْدَعُوكَ فَإِنَّ ...","يَـٰٓأَيُّهَا ٱلنَّبِىُّ قُل لِّمَن فِىٓ ...","بَرَآءَةٌ مِّنَ ٱللَّهِ وَرَسُولِهِۦٓ إِلَى ...","كَيْفَ يَكُونُ لِلْمُشْرِكِينَ عَهْدٌ عِندَ ...","قَـٰتِلُوهُمْ يُعَذِّبْهُمُ ٱللَّهُ بِأَيْدِيكُمْ وَيُخْزِهِمْ ...","يُبَشِّرُهُمْ رَبُّهُم بِرَحْمَةٍ مِّنْهُ وَرِضْوَٰنٍ ...","ثُمَّ يَتُوبُ ٱللَّهُ مِنۢ بَعْدِ ...","يُرِيدُونَ أَن يُطْفِـُٔوا۟ نُورَ ٱللَّهِ ...","إِنَّمَا ٱلنَّسِىٓءُ زِيَادَةٌ فِى ٱلْكُفْرِ ...","ٱنفِرُوا۟ خِفَافًا وَثِقَالًا وَجَـٰهِدُوا۟ بِأَمْوَٰلِكُمْ ...","لَقَدِ ٱبْتَغَوُا۟ ٱلْفِتْنَةَ مِن قَبْلُ ...","فَلَا تُعْجِبْكَ أَمْوَٰلُهُمْ وَلَآ أَوْلَـٰدُهُمْ ...","يَحْلِفُونَ بِٱللَّهِ لَكُمْ لِيُرْضُوكُمْ وَٱللَّهُ ...","كَٱلَّذِينَ مِن قَبْلِكُمْ كَانُوٓا۟ أَشَدَّ ...","يَـٰٓأَيُّهَا ٱلنَّبِىُّ جَـٰهِدِ ٱلْكُفَّارَ وَٱلْمُنَـٰفِقِينَ ...","ٱسْتَغْفِرْ لَهُمْ أَوْ لَا تَسْتَغْفِرْ ...","رَضُوا۟ بِأَن يَكُونُوا۟ مَعَ ٱلْخَوَالِفِ ...","يَعْتَذِرُونَ إِلَيْكُمْ إِذَا رَجَعْتُمْ إِلَيْهِمْ ...","وَٱلسَّـٰبِقُونَ ٱلْأَوَّلُونَ مِنَ ٱلْمُهَـٰجِرِينَ وَٱلْأَنصَارِ ...","وَٱلَّذِينَ ٱتَّخَذُوا۟ مَسْجِدًا ضِرَارًا وَكُفْرًا ...","ٱلتَّـٰٓئِبُونَ ٱلْعَـٰبِدُونَ ٱلْحَـٰمِدُونَ ٱلسَّـٰٓئِحُونَ ٱلرَّٰكِعُونَ ...","وَعَلَى ٱلثَّلَـٰثَةِ ٱلَّذِينَ خُلِّفُوا۟ حَتَّىٰٓ ...","يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ قَـٰتِلُوا۟ ٱلَّذِينَ ...","الٓر ۚ تِلْكَ ءَايَـٰتُ ٱلْكِتَـٰبِ ...","إِنَّ ٱلَّذِينَ لَا يَرْجُونَ لِقَآءَنَا ...","وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَاتُنَا بَيِّنَـٰتٍ ...","وَإِذَآ أَذَقْنَا ٱلنَّاسَ رَحْمَةً مِّنۢ ...","۞ لِّلَّذِينَ أَحْسَنُوا۟ ٱلْحُسْنَىٰ وَزِيَادَةٌ ...","قُلْ هَلْ مِن شُرَكَآئِكُم مَّن ...","وَمِنْهُم مَّن يَنظُرُ إِلَيْكَ ۚ ...","وَلَوْ أَنَّ لِكُلِّ نَفْسٍ ظَلَمَتْ ...","أَلَآ إِنَّ أَوْلِيَآءَ ٱللَّهِ لَا ...","۞ وَٱتْلُ عَلَيْهِمْ نَبَأَ نُوحٍ ...","وَقَالَ فِرْعَوْنُ ٱئْتُونِى بِكُلِّ سَـٰحِرٍ ...","قَالَ قَدْ أُجِيبَت دَّعْوَتُكُمَا فَٱسْتَقِيمَا ...","فَلَوْلَا كَانَتْ قَرْيَةٌ ءَامَنَتْ فَنَفَعَهَآ ...","وَإِن يَمْسَسْكَ ٱللَّهُ بِضُرٍّ فَلَا ...","۞ وَمَا مِن دَآبَّةٍ فِى ...","أَمْ يَقُولُونَ ٱفْتَرَىٰهُ ۖ قُلْ ...","أُو۟لَـٰٓئِكَ لَمْ يَكُونُوا۟ مُعْجِزِينَ فِى ...","وَيَـٰقَوْمِ لَآ أَسْـَٔلُكُمْ عَلَيْهِ مَالًا ...","وَيَصْنَعُ ٱلْفُلْكَ وَكُلَّمَا مَرَّ عَلَيْهِ ...","قَالَ يَـٰنُوحُ إِنَّهُۥ لَيْسَ مِنْ ...","إِن نَّقُولُ إِلَّا ٱعْتَرَىٰكَ بَعْضُ ...","قَالَ يَـٰقَوْمِ أَرَءَيْتُمْ إِن كُنتُ ...","قَالَتْ يَـٰوَيْلَتَىٰٓ ءَأَلِدُ وَأَنَا۠ عَجُوزٌ ...","فَلَمَّا جَآءَ أَمْرُنَا جَعَلْنَا عَـٰلِيَهَا ...","وَيَـٰقَوْمِ لَا يَجْرِمَنَّكُمْ شِقَاقِىٓ أَن ...","يَقْدُمُ قَوْمَهُۥ يَوْمَ ٱلْقِيَـٰمَةِ فَأَوْرَدَهُمُ ...","فَلَا تَكُ فِى مِرْيَةٍ مِّمَّا ...","وَلَوْ شَآءَ رَبُّكَ لَجَعَلَ ٱلنَّاسَ ...","قَالَ يَـٰبُنَىَّ لَا تَقْصُصْ رُءْيَاكَ ...","فَلَمَّا ذَهَبُوا۟ بِهِۦ وَأَجْمَعُوٓا۟ أَن ...","وَرَٰوَدَتْهُ ٱلَّتِى هُوَ فِى بَيْتِهَا ...","فَلَمَّا سَمِعَتْ بِمَكْرِهِنَّ أَرْسَلَتْ إِلَيْهِنَّ ...","وَٱتَّبَعْتُ مِلَّةَ ءَابَآءِىٓ إِبْرَٰهِيمَ وَإِسْحَـٰقَ ...","قَالُوٓا۟ أَضْغَـٰثُ أَحْلَـٰمٍ ۖ وَمَا ...","۞ وَمَآ أُبَرِّئُ نَفْسِىٓ ۚ ...","قَالَ هَلْ ءَامَنُكُمْ عَلَيْهِ إِلَّا ...","فَلَمَّا جَهَّزَهُم بِجَهَازِهِمْ جَعَلَ ٱلسِّقَايَةَ ...","قَالَ مَعَاذَ ٱللَّهِ أَن نَّأْخُذَ ...","يَـٰبَنِىَّ ٱذْهَبُوا۟ فَتَحَسَّسُوا۟ مِن يُوسُفَ ...","فَلَمَّآ أَن جَآءَ ٱلْبَشِيرُ أَلْقَىٰهُ ...","وَمَا تَسْـَٔلُهُمْ عَلَيْهِ مِنْ أَجْرٍ ...","الٓمٓر ۚ تِلْكَ ءَايَـٰتُ ٱلْكِتَـٰبِ ...","وَيَسْتَعْجِلُونَكَ بِٱلسَّيِّئَةِ قَبْلَ ٱلْحَسَنَةِ وَقَدْ ...","لَهُۥ دَعْوَةُ ٱلْحَقِّ ۖ وَٱلَّذِينَ ...","۞ أَفَمَن يَعْلَمُ أَنَّمَآ أُنزِلَ ...","ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ طُوبَىٰ ...","۞ مَّثَلُ ٱلْجَنَّةِ ٱلَّتِى وُعِدَ ...","وَيَقُولُ ٱلَّذِينَ كَفَرُوا۟ لَسْتَ مُرْسَلًا ...","وَإِذْ قَالَ مُوسَىٰ لِقَوْمِهِ ٱذْكُرُوا۟ ...","قَالَتْ لَهُمْ رُسُلُهُمْ إِن نَّحْنُ ...","أَلَمْ تَرَ أَنَّ ٱللَّهَ خَلَقَ ...","تُؤْتِىٓ أُكُلَهَا كُلَّ حِينٍۭ بِإِذْنِ ...","وَءَاتَىٰكُم مِّن كُلِّ مَا سَأَلْتُمُوهُ ...","مُهْطِعِينَ مُقْنِعِى رُءُوسِهِمْ لَا يَرْتَدُّ ...","الٓر ۚ تِلْكَ ءَايَـٰتُ ٱلْكِتَـٰبِ ...","وَلَقَدْ جَعَلْنَا فِى ٱلسَّمَآءِ بُرُوجًا ...","قَالَ يَـٰٓإِبْلِيسُ مَا لَكَ أَلَّا ...","إِذْ دَخَلُوا۟ عَلَيْهِ فَقَالُوا۟ سَلَـٰمًا ...","قَالَ هَـٰٓؤُلَآءِ بَنَاتِىٓ إِن كُنتُمْ ...","ٱلَّذِينَ جَعَلُوا۟ ٱلْقُرْءَانَ عِضِينَ ...","وَتَحْمِلُ أَثْقَالَكُمْ إِلَىٰ بَلَدٍ لَّمْ ...","وَأَلْقَىٰ فِى ٱلْأَرْضِ رَوَٰسِىَ أَن ...","ثُمَّ يَوْمَ ٱلْقِيَـٰمَةِ يُخْزِيهِمْ وَيَقُولُ ...","وَقَالَ ٱلَّذِينَ أَشْرَكُوا۟ لَوْ شَآءَ ...","وَمَآ أَرْسَلْنَا مِن قَبْلِكَ إِلَّا ...","لِيَكْفُرُوا۟ بِمَآ ءَاتَيْنَـٰهُمْ ۚ فَتَمَتَّعُوا۟ ...","وَٱللَّهُ أَنزَلَ مِنَ ٱلسَّمَآءِ مَآءً ...","وَيَعْبُدُونَ مِن دُونِ ٱللَّهِ مَا ...","وَٱللَّهُ جَعَلَ لَكُم مِّنۢ بُيُوتِكُمْ ...","ٱلَّذِينَ كَفَرُوا۟ وَصَدُّوا۟ عَن سَبِيلِ ...","وَلَا تَتَّخِذُوٓا۟ أَيْمَـٰنَكُمْ دَخَلًۢا بَيْنَكُمْ ...","وَلَقَدْ نَعْلَمُ أَنَّهُمْ يَقُولُونَ إِنَّمَا ...","۞ يَوْمَ تَأْتِى كُلُّ نَفْسٍ ...","ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ عَمِلُوا۟ ...","سُبْحَـٰنَ ٱلَّذِىٓ أَسْرَىٰ بِعَبْدِهِۦ لَيْلًا ...","عَسَىٰ رَبُّكُمْ أَن يَرْحَمَكُمْ ۚ ...","مَّن كَانَ يُرِيدُ ٱلْعَاجِلَةَ عَجَّلْنَا ...","وَإِمَّا تُعْرِضَنَّ عَنْهُمُ ٱبْتِغَآءَ رَحْمَةٍ ...","ذَٰلِكَ مِمَّآ أَوْحَىٰٓ إِلَيْكَ رَبُّكَ ...","۞ قُلْ كُونُوا۟ حِجَارَةً أَوْ ...","وَمَا مَنَعَنَآ أَن نُّرْسِلَ بِٱلْـَٔايَـٰتِ ...","وَإِذَا مَسَّكُمُ ٱلضُّرُّ فِى ٱلْبَحْرِ ...","وَإِن كَادُوا۟ لَيَسْتَفِزُّونَكَ مِنَ ٱلْأَرْضِ ...","إِلَّا رَحْمَةً مِّن رَّبِّكَ ۚ ...","وَمَن يَهْدِ ٱللَّهُ فَهُوَ ٱلْمُهْتَدِ ...","وَبِٱلْحَقِّ أَنزَلْنَـٰهُ وَبِٱلْحَقِّ نَزَلَ ۗ ...","مَّا لَهُم بِهِۦ مِنْ عِلْمٍ ...","وَإِذِ ٱعْتَزَلْتُمُوهُمْ وَمَا يَعْبُدُونَ إِلَّا ...","وَكَذَٰلِكَ أَعْثَرْنَا عَلَيْهِمْ لِيَعْلَمُوٓا۟ أَنَّ ...","وَٱصْبِرْ نَفْسَكَ مَعَ ٱلَّذِينَ يَدْعُونَ ...","وَدَخَلَ جَنَّتَهُۥ وَهُوَ ظَالِمٌ لِّنَفْسِهِۦ ...","ٱلْمَالُ وَٱلْبَنُونَ زِينَةُ ٱلْحَيَوٰةِ ٱلدُّنْيَا ...","وَلَقَدْ صَرَّفْنَا فِى هَـٰذَا ٱلْقُرْءَانِ ...","فَلَمَّا جَاوَزَا قَالَ لِفَتَىٰهُ ءَاتِنَا ...","۞ قَالَ أَلَمْ أَقُل لَّكَ ...","إِنَّا مَكَّنَّا لَهُۥ فِى ٱلْأَرْضِ ...","قَالَ هَـٰذَا رَحْمَةٌ مِّن رَّبِّى ...","كٓهيعٓصٓ ۝ ذِكْرُ رَحْمَتِ رَبِّكَ عَبْدَهُۥ ...","يَـٰيَحْيَىٰ خُذِ ٱلْكِتَـٰبَ بِقُوَّةٍ ۖ ...","فَكُلِى وَٱشْرَبِى وَقَرِّى عَيْنًا ۖ ...","وَأَنذِرْهُمْ يَوْمَ ٱلْحَسْرَةِ إِذْ قُضِىَ ...","وَنَـٰدَيْنَـٰهُ مِن جَانِبِ ٱلطُّورِ ٱلْأَيْمَنِ ...","رَّبُّ ٱلسَّمَـٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ...","أَفَرَءَيْتَ ٱلَّذِى كَفَرَ بِـَٔايَـٰتِنَا وَقَالَ ...","إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ ...","وَأَنَا ٱخْتَرْتُكَ فَٱسْتَمِعْ لِمَا يُوحَىٰٓ ...","إِذْ أَوْحَيْنَآ إِلَىٰٓ أُمِّكَ مَا ...","قَالَ عِلْمُهَا عِندَ رَبِّى فِى ...","قَالُوا۟ يَـٰمُوسَىٰٓ إِمَّآ أَن تُلْقِىَ ...","وَلَقَدْ أَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ أَنْ ...","فَأَخْرَجَ لَهُمْ عِجْلًا جَسَدًا لَّهُۥ ...","كَذَٰلِكَ نَقُصُّ عَلَيْكَ مِنْ أَنۢبَآءِ ...","فَتَعَـٰلَى ٱللَّهُ ٱلْمَلِكُ ٱلْحَقُّ ۗ ...","قَالَ كَذَٰلِكَ أَتَتْكَ ءَايَـٰتُنَا فَنَسِيتَهَا ...","ٱقْتَرَبَ لِلنَّاسِ حِسَابُهُمْ وَهُمْ فِى ...","وَكَمْ قَصَمْنَا مِن قَرْيَةٍ كَانَتْ ...","وَمَآ أَرْسَلْنَا مِن قَبْلِكَ مِن ...","وَإِذَا رَءَاكَ ٱلَّذِينَ كَفَرُوٓا۟ إِن ...","قُلْ إِنَّمَآ أُنذِرُكُم بِٱلْوَحْىِ ۚ ...","فَجَعَلَهُمْ جُذَٰذًا إِلَّا كَبِيرًا لَّهُمْ ...","وَجَعَلْنَـٰهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا وَأَوْحَيْنَآ ...","وَمِنَ ٱلشَّيَـٰطِينِ مَن يَغُوصُونَ لَهُۥ ...","وَٱلَّتِىٓ أَحْصَنَتْ فَرْجَهَا فَنَفَخْنَا فِيهَا ...","لَا يَسْمَعُونَ حَسِيسَهَا ۖ وَهُمْ ...","يَـٰٓأَيُّهَا ٱلنَّاسُ ٱتَّقُوا۟ رَبَّكُمْ ۚ ...","ذَٰلِكَ بِأَنَّ ٱللَّهَ هُوَ ٱلْحَقُّ ...","وَكَذَٰلِكَ أَنزَلْنَـٰهُ ءَايَـٰتٍۭ بَيِّنَـٰتٍ وَأَنَّ ...","وَهُدُوٓا۟ إِلَى ٱلطَّيِّبِ مِنَ ٱلْقَوْلِ ...","حُنَفَآءَ لِلَّهِ غَيْرَ مُشْرِكِينَ بِهِۦ ...","أُذِنَ لِلَّذِينَ يُقَـٰتَلُونَ بِأَنَّهُمْ ظُلِمُوا۟ ...","وَيَسْتَعْجِلُونَكَ بِٱلْعَذَابِ وَلَن يُخْلِفَ ٱللَّهُ ...","ٱلْمُلْكُ يَوْمَئِذٍ لِّلَّهِ يَحْكُمُ بَيْنَهُمْ ...","أَلَمْ تَرَ أَنَّ ٱللَّهَ سَخَّرَ ...","يَـٰٓأَيُّهَا ٱلنَّاسُ ضُرِبَ مَثَلٌ فَٱسْتَمِعُوا۟ ...","قَدْ أَفْلَحَ ٱلْمُؤْمِنُونَ ...","وَأَنزَلْنَا مِنَ ٱلسَّمَآءِ مَآءًۢ بِقَدَرٍ ...","فَإِذَا ٱسْتَوَيْتَ أَنتَ وَمَن مَّعَكَ ...","مَا تَسْبِقُ مِنْ أُمَّةٍ أَجَلَهَا ...","وَٱلَّذِينَ يُؤْتُونَ مَآ ءَاتَوا۟ وَّقُلُوبُهُمْ ...","۞ وَلَوْ رَحِمْنَـٰهُمْ وَكَشَفْنَا مَا ...","بَلْ أَتَيْنَـٰهُم بِٱلْحَقِّ وَإِنَّهُمْ لَكَـٰذِبُونَ ...","أَلَمْ تَكُنْ ءَايَـٰتِى تُتْلَىٰ عَلَيْكُمْ ...","سُورَةٌ أَنزَلْنَـٰهَا وَفَرَضْنَـٰهَا وَأَنزَلْنَا فِيهَآ ...","إِنَّ ٱلَّذِينَ جَآءُو بِٱلْإِفْكِ عُصْبَةٌ ...","۞ يَـٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا ...","فَإِن لَّمْ تَجِدُوا۟ فِيهَآ أَحَدًا ...","وَأَنكِحُوا۟ ٱلْأَيَـٰمَىٰ مِنكُمْ وَٱلصَّـٰلِحِينَ مِنْ ...","رِجَالٌ لَّا تُلْهِيهِمْ تِجَـٰرَةٌ وَلَا ...","يُقَلِّبُ ٱللَّهُ ٱلَّيْلَ وَٱلنَّهَارَ ۚ ...","قُلْ أَطِيعُوا۟ ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ ...","وَإِذَا بَلَغَ ٱلْأَطْفَـٰلُ مِنكُمُ ٱلْحُلُمَ ...","إِنَّمَا ٱلْمُؤْمِنُونَ ٱلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ ...","وَٱتَّخَذُوا۟ مِن دُونِهِۦٓ ءَالِهَةً لَّا ...","إِذَا رَأَتْهُم مِّن مَّكَانٍۭ بَعِيدٍ ...","۞ وَقَالَ ٱلَّذِينَ لَا يَرْجُونَ ...","وَلَا يَأْتُونَكَ بِمَثَلٍ إِلَّا جِئْنَـٰكَ ...","أَمْ تَحْسَبُ أَنَّ أَكْثَرَهُمْ يَسْمَعُونَ ...","وَمَآ أَرْسَلْنَـٰكَ إِلَّا مُبَشِّرًا وَنَذِيرًا ...","وَٱلَّذِينَ لَا يَدْعُونَ مَعَ ٱللَّهِ ...","طسٓمٓ ۝ تِلْكَ ءَايَـٰتُ ٱلْكِتَـٰبِ ٱلْمُبِينِ ...","قَالَ فَعَلْتُهَآ إِذًا وَأَنَا۠ مِنَ ...","لَعَلَّنَا نَتَّبِعُ ٱلسَّحَرَةَ إِن كَانُوا۟ ...","فَلَمَّا تَرَٰٓءَا ٱلْجَمْعَانِ قَالَ أَصْحَـٰبُ ...","وَٱجْعَل لِّى لِسَانَ صِدْقٍ فِى ...","قَالَ وَمَا عِلْمِى بِمَا كَانُوا۟ ...","إِنْ هَـٰذَآ إِلَّا خُلُقُ ٱلْأَوَّلِينَ ...","كَذَّبَتْ قَوْمُ لُوطٍ ٱلْمُرْسَلِينَ ...","وَٱتَّقُوا۟ ٱلَّذِى خَلَقَكُمْ وَٱلْجِبِلَّةَ ٱلْأَوَّلِينَ ...","مَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ ...","طسٓ ۚ تِلْكَ ءَايَـٰتُ ٱلْقُرْءَانِ ...","وَجَحَدُوا۟ بِهَا وَٱسْتَيْقَنَتْهَآ أَنفُسُهُمْ ظُلْمًا ...","إِنِّى وَجَدتُّ ٱمْرَأَةً تَمْلِكُهُمْ وَأُوتِيَتْ ...","فَلَمَّا جَآءَ سُلَيْمَـٰنَ قَالَ أَتُمِدُّونَنِ ...","وَلَقَدْ أَرْسَلْنَآ إِلَىٰ ثَمُودَ أَخَاهُمْ ...","۞ فَمَا كَانَ جَوَابَ قَوْمِهِۦٓ ...","أَمَّن يَبْدَؤُا۟ ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ ...","وَإِنَّهُۥ لَهُدًى وَرَحْمَةٌ لِّلْمُؤْمِنِينَ ...","مَن جَآءَ بِٱلْحَسَنَةِ فَلَهُۥ خَيْرٌ ...","وَنُمَكِّنَ لَهُمْ فِى ٱلْأَرْضِ وَنُرِىَ ...","وَلَمَّا بَلَغَ أَشُدَّهُۥ وَٱسْتَوَىٰٓ ءَاتَيْنَـٰهُ ...","وَلَمَّا تَوَجَّهَ تِلْقَآءَ مَدْيَنَ قَالَ ...","۞ فَلَمَّا قَضَىٰ مُوسَى ٱلْأَجَلَ ...","فَلَمَّا جَآءَهُم مُّوسَىٰ بِـَٔايَـٰتِنَا بَيِّنَـٰتٍ ...","وَمَا كُنتَ بِجَانِبِ ٱلْغَرْبِىِّ إِذْ ...","۞ وَلَقَدْ وَصَّلْنَا لَهُمُ ٱلْقَوْلَ ...","وَمَآ أُوتِيتُم مِّن شَىْءٍ فَمَتَـٰعُ ...","قُلْ أَرَءَيْتُمْ إِن جَعَلَ ٱللَّهُ ...","قَالَ إِنَّمَآ أُوتِيتُهُۥ عَلَىٰ عِلْمٍ ...","إِنَّ ٱلَّذِى فَرَضَ عَلَيْكَ ٱلْقُرْءَانَ ...","وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّـٰلِحَـٰتِ لَنُكَفِّرَنَّ ...","فَأَنجَيْنَـٰهُ وَأَصْحَـٰبَ ٱلسَّفِينَةِ وَجَعَلْنَـٰهَآ ءَايَةً ...","فَمَا كَانَ جَوَابَ قَوْمِهِۦٓ إِلَّآ ...","وَلَمَّا جَآءَتْ رُسُلُنَآ إِبْرَٰهِيمَ بِٱلْبُشْرَىٰ ...","وَقَـٰرُونَ وَفِرْعَوْنَ وَهَـٰمَـٰنَ ۖ وَلَقَدْ ...","۞ وَلَا تُجَـٰدِلُوٓا۟ أَهْلَ ٱلْكِتَـٰبِ ...","وَيَسْتَعْجِلُونَكَ بِٱلْعَذَابِ ۚ وَلَوْلَآ أَجَلٌ ...","وَمَا هَـٰذِهِ ٱلْحَيَوٰةُ ٱلدُّنْيَآ إِلَّا ...","وَعْدَ ٱللَّهِ ۖ لَا يُخْلِفُ ...","وَأَمَّا ٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا ...","وَمِنْ ءَايَـٰتِهِۦٓ أَن تَقُومَ ٱلسَّمَآءُ ...","وَإِذَا مَسَّ ٱلنَّاسَ ضُرٌّ دَعَوْا۟ ...","قُلْ سِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ ...","وَلَئِنْ أَرْسَلْنَا رِيحًا فَرَأَوْهُ مُصْفَرًّا ...","الٓمٓ ۝ تِلْكَ ءَايَـٰتُ ٱلْكِتَـٰبِ ٱلْحَكِيمِ ...","وَلَقَدْ ءَاتَيْنَا لُقْمَـٰنَ ٱلْحِكْمَةَ أَنِ ...","أَلَمْ تَرَوْا۟ أَنَّ ٱللَّهَ سَخَّرَ ...","أَلَمْ تَرَ أَنَّ ٱللَّهَ يُولِجُ ...","الٓمٓ ۝ تَنزِيلُ ٱلْكِتَـٰبِ لَا رَيْبَ ...","وَلَوْ تَرَىٰٓ إِذِ ٱلْمُجْرِمُونَ نَاكِسُوا۟ ...","وَلَنُذِيقَنَّهُم مِّنَ ٱلْعَذَابِ ٱلْأَدْنَىٰ دُونَ ...","يَـٰٓأَيُّهَا ٱلنَّبِىُّ ٱتَّقِ ٱللَّهَ وَلَا ...","وَإِذْ أَخَذْنَا مِنَ ٱلنَّبِيِّـۧنَ مِيثَـٰقَهُمْ ...","قُل لَّن يَنفَعَكُمُ ٱلْفِرَارُ إِن ...","مِّنَ ٱلْمُؤْمِنِينَ رِجَالٌ صَدَقُوا۟ مَا ...","۞ وَمَن يَقْنُتْ مِنكُنَّ لِلَّهِ ...","وَمَا كَانَ لِمُؤْمِنٍ وَلَا مُؤْمِنَةٍ ...","تَحِيَّتُهُمْ يَوْمَ يَلْقَوْنَهُۥ سَلَـٰمٌ ۚ ...","۞ تُرْجِى مَن تَشَآءُ مِنْهُنَّ ...","لَّا جُنَاحَ عَلَيْهِنَّ فِىٓ ءَابَآئِهِنَّ ...","يَسْـَٔلُكَ ٱلنَّاسُ عَنِ ٱلسَّاعَةِ ۖ ...","ٱلْحَمْدُ لِلَّهِ ٱلَّذِى لَهُۥ مَا ...","أَفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَم ...","لَقَدْ كَانَ لِسَبَإٍ فِى مَسْكَنِهِمْ ...","وَلَا تَنفَعُ ٱلشَّفَـٰعَةُ عِندَهُۥٓ إِلَّا ...","قَالَ ٱلَّذِينَ ٱسْتَكْبَرُوا۟ لِلَّذِينَ ٱسْتُضْعِفُوٓا۟ ...","وَيَوْمَ يَحْشُرُهُمْ جَمِيعًا ثُمَّ يَقُولُ ...","قُلْ جَآءَ ٱلْحَقُّ وَمَا يُبْدِئُ ...","وَإِن يُكَذِّبُوكَ فَقَدْ كُذِّبَتْ رُسُلٌ ...","وَمَا يَسْتَوِى ٱلْبَحْرَانِ هَـٰذَا عَذْبٌ ...","وَمَا يَسْتَوِى ٱلْأَعْمَىٰ وَٱلْبَصِيرُ ...","وَٱلَّذِىٓ أَوْحَيْنَآ إِلَيْكَ مِنَ ٱلْكِتَـٰبِ ...","هُوَ ٱلَّذِى جَعَلَكُمْ خَلَـٰٓئِفَ فِى ...","وَلَوْ يُؤَاخِذُ ٱللَّهُ ٱلنَّاسَ بِمَا ...","وَٱضْرِبْ لَهُم مَّثَلًا أَصْحَـٰبَ ٱلْقَرْيَةِ ...","۞ وَمَآ أَنزَلْنَا عَلَىٰ قَوْمِهِۦ ...","وَءَايَةٌ لَّهُمْ أَنَّا حَمَلْنَا ذُرِّيَّتَهُمْ ...","إِنَّ أَصْحَـٰبَ ٱلْجَنَّةِ ٱلْيَوْمَ فِى ...","أَوَلَمْ يَرَوْا۟ أَنَّا خَلَقْنَا لَهُم ...","وَٱلصَّـٰٓفَّـٰتِ صَفًّا ۝ فَٱلزَّٰجِرَٰتِ زَجْرًا ...","مَا لَكُمْ لَا تَنَاصَرُونَ ...","يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ ...","وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ ٱلْبَاقِينَ ...","فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ ...","فَكَذَّبُوهُ فَإِنَّهُمْ لَمُحْضَرُونَ ...","مَا لَكُمْ كَيْفَ تَحْكُمُونَ ...","صٓ ۚ وَٱلْقُرْءَانِ ذِى ٱلذِّكْرِ ...","ٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَٱذْكُرْ ...","وَمَا خَلَقْنَا ٱلسَّمَآءَ وَٱلْأَرْضَ وَمَا ...","وَوَهَبْنَا لَهُۥٓ أَهْلَهُۥ وَمِثْلَهُم مَّعَهُمْ ...","وَقَالُوا۟ مَا لَنَا لَا نَرَىٰ ...","قَالَ فَٱلْحَقُّ وَٱلْحَقَّ أَقُولُ ...","خَلَقَكُم مِّن نَّفْسٍ وَٰحِدَةٍ ثُمَّ ...","قُلْ إِنِّىٓ أُمِرْتُ أَنْ أَعْبُدَ ...","أَفَمَن شَرَحَ ٱللَّهُ صَدْرَهُۥ لِلْإِسْلَـٰمِ ...","۞ فَمَنْ أَظْلَمُ مِمَّن كَذَبَ ...","إِنَّآ أَنزَلْنَا عَلَيْكَ ٱلْكِتَـٰبَ لِلنَّاسِ ...","وَبَدَا لَهُمْ سَيِّـَٔاتُ مَا كَسَبُوا۟ ...","أَوْ تَقُولَ لَوْ أَنَّ ٱللَّهَ ...","وَنُفِخَ فِى ٱلصُّورِ فَصَعِقَ مَن ...","وَتَرَى ٱلْمَلَـٰٓئِكَةَ حَآفِّينَ مِنْ حَوْلِ ...","رَبَّنَا وَأَدْخِلْهُمْ جَنَّـٰتِ عَدْنٍ ٱلَّتِى ...","ٱلْيَوْمَ تُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا ...","وَقَالَ فِرْعَوْنُ ذَرُونِىٓ أَقْتُلْ مُوسَىٰ ...","وَلَقَدْ جَآءَكُمْ يُوسُفُ مِن قَبْلُ ...","۞ وَيَـٰقَوْمِ مَا لِىٓ أَدْعُوكُمْ ...","قَالُوٓا۟ أَوَلَمْ تَكُ تَأْتِيكُمْ رُسُلُكُم ...","إِنَّ ٱلسَّاعَةَ لَـَٔاتِيَةٌ لَّا رَيْبَ ...","هُوَ ٱلَّذِى خَلَقَكُم مِّن تُرَابٍ ...","وَلَقَدْ أَرْسَلْنَا رُسُلًا مِّن قَبْلِكَ ...","حمٓ ۝ تَنزِيلٌ مِّنَ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ ...","فَقَضَىٰهُنَّ سَبْعَ سَمَـٰوَاتٍ فِى يَوْمَيْنِ ...","وَقَالُوا۟ لِجُلُودِهِمْ لِمَ شَهِدتُّمْ عَلَيْنَا ...","إِنَّ ٱلَّذِينَ قَالُوا۟ رَبُّنَا ٱللَّهُ ...","وَمِنْ ءَايَـٰتِهِۦٓ أَنَّكَ تَرَى